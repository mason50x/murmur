<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime stays on (no DYLD_* injection, no unsigned executable memory, no
	     debugger attach). Only these two exceptions: -->
	<!-- Record from the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Load the bundled Sparkle.framework. Murmur is signed with a self-signed certificate,
	     which has no Apple Team ID, so library validation would reject every embedded framework.
	     See SECURITY.md. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
